<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FirmwareStudio</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>FirmwareStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window/title-bar icon can reference it; ApplicationIcon sets the .exe icon. -->
    <Resource Include="FirmwareStudio.ico" />
  </ItemGroup>

  <!-- Bundle the WCH CH341 SPI DLL next to the exe when it's present in third_party/ (see that folder's
       README). Conditional + Link so build/publish work whether or not the DLL has been added, and the
       DLL lands at the output root next to FirmwareStudio.exe (where the loader finds it). -->
  <ItemGroup Condition="Exists('third_party\CH341DLLA64.dll')">
    <None Include="third_party\CH341DLLA64.dll" Link="CH341DLLA64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FirmwareStudio.Core\FirmwareStudio.Core.csproj" />
  </ItemGroup>

</Project>
